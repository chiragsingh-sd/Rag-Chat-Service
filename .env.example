APP_NAME=rag-chat-service
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_chat
DATABASE_ECHO=false

SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Groq exposes an OpenAI-compatible API. Put the Groq key here.
OPENAI_API_KEY=replace-with-your-groq-api-key
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5
CHAT_HISTORY_LIMIT=10
