# Application behavior and logging.
APP_NAME=rag-chat-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL connection used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/rag_chat
DATABASE_ECHO=false

# JWT authentication and token lifetime.
SECRET_KEY=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Groq uses an OpenAI-compatible API client.
OPENAI_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1

# Document embedding and chunking configuration.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval and conversation-memory limits.
RAG_TOP_K=5
CHAT_HISTORY_LIMIT=10
